# Copier vers .env.local (jamais commité) et renseigner les valeurs réelles.
# Voir ARCHITECTURE.md §9 et SECURITY.md §7.

# Projet Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — SERVEUR UNIQUEMENT, ne jamais préfixer NEXT_PUBLIC_,
# ne jamais commiter, ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# URL officielle EFS vers laquelle redirigent les liens courts de tracking (§4.5 du PRD).
EFS_TARGET_URL=

# URL publique du déploiement (utilisée dans les liens envoyés par e-mail :
# invitation, connexion). Ex. https://bomoi-mediation-hub.vercel.app
NEXT_PUBLIC_SITE_URL=
